{
  extends: ['github>voron-software/.github:renovate.json5'],
  bumpVersion: 'patch',
  packageRules: [
    {
      // The nightly pin is tied to the rustc-internals API the driver uses
      // (see AGENTS.md), and the MSRV job must build on the declared
      // rust-version, so neither toolchain is a routine dependency bump.
      matchDepNames: ['rust'],
      enabled: false,
    },
  ],
}
