{
  "roots": [
    {
      "root": "mutual_recursion::root",
      "instance": "root",
      "verdict": {
        "kind": "pass"
      },
      "environment": {
        "panic_strategy": "unwind",
        "panic_paths": "out_of_scope",
        "opt_level": "No",
        "mir_opt_level": 1,
        "overflow_checks": true,
        "debug_assertions": true,
        "target_triple": "<host>",
        "rustc_version": "1.99.0-nightly (ad3d0bc14 2026-07-31)",
        "all_crates": false,
        "build_std": false
      }
    }
  ],
  "panic_strategy": "unwind",
  "schema_version": 3
}
