{
  "roots": [
    {
      "root": "explicit_panic::root",
      "instance": "root",
      "verdict": {
        "kind": "pass"
      },
      "environment": {
        "panic_strategy": "abort",
        "panic_paths": "out_of_scope",
        "opt_level": "No",
        "mir_opt_level": 1,
        "overflow_checks": true,
        "debug_assertions": true,
        "target_triple": "<host>",
        "rustc_version": "1.101.0-nightly (92b5b8c87 2026-10-29)",
        "all_crates": false,
        "build_std": false
      }
    }
  ],
  "panic_strategy": "abort",
  "schema_version": 3
}
